          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"{{cpfClienteValido}}\",\n  \"senha\": \"SenhaErrada@123\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/auth/cpf",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "auth",
            "cpf"
          ]
        }
      },
      "response": []
    },
    {
