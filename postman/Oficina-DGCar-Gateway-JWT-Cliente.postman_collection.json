{
  "info": {
    "_postman_id": "0dbaec97-967b-4dd9-9737-0f64a0fa8fe0",
    "name": "Oficina DGCar - Gateway JWT Cliente",
    "description": "Evidencia do fluxo CPF + senha -> Lambda Auth -> JWT CLIENTE -> API Spring protegida pelo API Gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Autenticar cliente por CPF e senha",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('retorna 200 OK', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test('retorna accessToken Bearer', function () {",
              "  pm.expect(body.tokenType).to.eql('Bearer');",
              "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.collectionVariables.set('clienteToken', body.accessToken);",
              "",
              "const payloadPart = body.accessToken.split('.')[1];",
              "const normalized = payloadPart.replace(/-/g, '+').replace(/_/g, '/');",
              "const padded = normalized.padEnd(normalized.length + (4 - normalized.length % 4) % 4, '=');",
              "const payload = JSON.parse(atob(padded));",
              "",
              "pm.collectionVariables.set('clienteId', String(payload.clienteId));",
              "pm.collectionVariables.set('cpfClienteValido', payload.sub);",
              "",
              "pm.test('JWT externo possui claims de cliente', function () {",
              "  pm.expect(payload.tipo).to.eql('CLIENTE');",
              "  pm.expect(payload.sub).to.eql(pm.collectionVariables.get('cpfClienteValido'));",
              "  pm.expect(payload.clienteId).to.exist;",
              "  pm.expect(payload.iss).to.eql('oficina-dgcar-auth-lambda');",
              "  pm.expect(payload.aud).to.eql('oficina-dgcar-api');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"{{cpfClienteValido}}\",\n  \"senha\": \"{{senhaClienteValida}}\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/auth/cpf",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "auth",
            "cpf"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Negar autenticacao sem senha",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"retorna 400 Bad Request\", function () {",
              "  pm.response.to.have.status(400);",
              "});",
              "",
              "const body = pm.response.json();",
              "pm.test(\"senha obrigatoria foi sinalizada\", function () {",
              "  pm.expect(body.error).to.eql(\"SENHA_OBRIGATORIA\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"{{cpfClienteValido}}\"\n}"
        },
        "url": {
          "raw": "{{gatewayBaseUrl}}/auth/cpf",
          "host": [
            "{{gatewayBaseUrl}}"
          ],
          "path": [
            "auth",
            "cpf"
          ]
        }
      },
      "response": []
    },
