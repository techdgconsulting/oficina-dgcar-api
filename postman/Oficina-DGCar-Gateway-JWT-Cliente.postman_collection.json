              "});",
              "",
              "const body = pm.response.json();",
              "pm.test(\"credenciais invalidas foram sinalizadas\", function () {",
              "  pm.expect(body.error).to.eql(\"CREDENCIAIS_INVALIDAS\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
