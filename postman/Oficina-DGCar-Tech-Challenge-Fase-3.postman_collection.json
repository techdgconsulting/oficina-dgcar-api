                  "var token = String(json.linkAprovacao).split('/decisoes-cliente/')[1].split('/aprovar')[0];",
                  "pm.collectionVariables.set('email_orcamentoDecisaoToken', token);",
                  "console.log('[EMAIL 08] Deve chegar e-mail de orcamento com links de decisao. Token salvo.');"
                ],
