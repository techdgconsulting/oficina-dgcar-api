        {
          "name": "00 - Preparar dados e Login GESTOR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"gestor1\",\n  \"password\": \"senha123\"\n}"
            },
            "description": "Antes de rodar esta pasta, defina a variavel da collection emailClienteNotificacao com o e-mail que deve receber as mensagens no Mailtrap/SMTP."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "function randomDigits(size) { var out = ''; for (var i = 0; i < size; i++) { out += Math.floor(Math.random() * 10); } return out; }",
                  "function cpfCheckDigit(base) { var sum = 0; for (var i = 0; i < base.length; i++) { sum += parseInt(base[i], 10) * (base.length + 1 - i); } var mod = sum % 11; return mod < 2 ? 0 : 11 - mod; }",
                  "function generateCpf() { var base = randomDigits(9); var d1 = cpfCheckDigit(base); var d2 = cpfCheckDigit(base + d1); return base + d1 + d2; }",
                  "var email = pm.collectionVariables.get('emailClienteNotificacao');",
                  "if (!email || email.indexOf('@') === -1) { throw new Error('Defina a variavel emailClienteNotificacao com um e-mail valido antes de rodar esta pasta.'); }",
                  "var runId = Date.now().toString().slice(-8);",
                  "pm.collectionVariables.set('email_runId', runId);",
                  "pm.collectionVariables.set('email_documento', generateCpf());",
                  "pm.collectionVariables.set('email_placa', 'EML' + runId.slice(-1) + 'A' + runId.slice(-2));",
                  "['email_tokenGestor','email_tokenAtendente','email_tokenMecanico','email_servicoId','email_pecaId','email_osId','email_osNumero','email_orcamentoDecisaoToken'].forEach(function(k) { pm.collectionVariables.unset(k); });",
                  "console.log('[EMAIL E2E] runId=' + runId + ', documento=' + pm.collectionVariables.get('email_documento') + ', placa=' + pm.collectionVariables.get('email_placa') + ', email=' + email);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[EMAIL 00] Login GESTOR 200', () => pm.response.to.have.status(200));",
                  "var json = pm.response.json();",
                  "pm.test('[EMAIL 00] Token GESTOR recebido', () => pm.expect(json.token).to.be.a('string').and.not.be.empty);",
                  "pm.collectionVariables.set('email_tokenGestor', json.token);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
