        {
          "name": "14 - Listar fila operacional de OS",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/ordens-servico/fila",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "ordens-servico",
                "fila"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{email_tokenAtendente}}",
                  "type": "string"
                }
              ]
            },
            "description": "Valida a fila operacional da oficina: apenas OS abertas em RECEBIDA, EM_DIAGNOSTICO, AGUARDANDO_APROVACAO ou EM_EXECUCAO, ordenadas por prioridade operacional e sem OS finalizadas/entregues."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('[EMAIL 14] Fila operacional 200', () => pm.response.to.have.status(200));",
                  "var body;",
                  "try {",
                  "  body = pm.response.json();",
                  "} catch (e) {",
                  "  throw new Error('[EMAIL 14] Resposta nao e JSON. Body recebido: ' + pm.response.text());",
                  "}",
                  "pm.test('[EMAIL 14] Resposta e array', () => pm.expect(body).to.be.an('array'));",
                  "var permitidos = ['EM_EXECUCAO', 'AGUARDANDO_APROVACAO', 'EM_DIAGNOSTICO', 'RECEBIDA'];",
                  "var excluidos = ['FINALIZADA', 'AGUARDANDO_RETIRADA', 'ENTREGUE', 'CANCELADA'];",
                  "pm.test('[EMAIL 14] Fila contem apenas status operacionais', () => body.forEach(os => pm.expect(permitidos).to.include(os.status)));",
                  "pm.test('[EMAIL 14] Fila nao contem status encerrados', () => body.forEach(os => pm.expect(excluidos).to.not.include(os.status)));",
                  "var prioridade = { EM_EXECUCAO: 1, AGUARDANDO_APROVACAO: 2, EM_DIAGNOSTICO: 3, RECEBIDA: 4 };",
                  "pm.test('[EMAIL 14] Ordenacao por prioridade operacional', () => { for (let i = 1; i < body.length; i++) { pm.expect(prioridade[body[i - 1].status]).to.be.at.most(prioridade[body[i].status]); } });",
                  "var osNumero = pm.collectionVariables.get('email_osNumero');",
                  "pm.test('[EMAIL 14] OS entregue no fluxo nao aparece na fila', () => pm.expect(body.some(os => os.numero === osNumero)).to.eql(false));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "response": []
        }
      ],
      "description": "Fluxo dedicado para validar envio real de notificacoes por e-mail ao cliente. Antes de executar, configure emailClienteNotificacao com um e-mail valido e rode a aplicacao com OFICINA_EMAIL_MODE=SMTP. Para garantir todos os status, configure PAGAMENTO_GATEWAY_APPROVAL_RATE=1.0."
    }
