Content-Type: {{contentType}}
Authorization: Bearer {{tokenGestor}}

{
  "nome": "Troca de Óleo Sintético",
  "descricao": "Troca de óleo sintético do motor com filtro premium",
  "valorUnitario": 250.00,
  "tempoEstimadoMinutos": 45
